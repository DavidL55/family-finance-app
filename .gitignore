# NO trailing slash, deliberately (batch 7 tooling hazard): a worktree agent symlinks
# node_modules, and `node_modules/` matches only real directories — so the symlink showed up as
# untracked and `git add -A` in a worktree would have committed a symlink pointing into the main
# repo. Without the slash the pattern matches the symlink too.
node_modules
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
!functions/.env.local.example
.firebase/
.claude/
.superpowers/
.emulator-data/
.env.local
backups/

# Real family data (28.08) — David's actual financial/medical/family documents live under
# family-data/ for local processing. PERSONAL DATA, NEVER COMMITTED. The synthetic demo corpus
# in scripts/ remains the only data git knows about.
family-data
