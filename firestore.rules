rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function memberId() { return request.auth.token.memberId; }
    function isSuperAdmin() { return isSignedIn() && role() == 'super-admin'; }
    function isParent() { return isSignedIn() && role() == 'parent'; }
    // A "member" (D1) with a resolved role at all — used to require role+memberId are both set
    // (an Auth user with no claims must be denied everywhere, never fall through as a guest).
    function hasRole() { return isSignedIn() && role() in ['super-admin', 'parent', 'member']; }

    function myMember() {
      return get(/databases/$(database)/documents/members/$(memberId())).data;
    }

    // Missing module/action defaults to 'none' — fail closed (tested explicitly in Task 6).
    function myLevel(module, action) {
      return myMember().get('resolvedPermissions', {}).get(module, {}).get(action, 'none');
    }

    // 'own' grants access when the doc's `ownerId` (a memberId) matches the caller — OR, for a row
    // the T3 backfill has not reached, when its `owner` field (a DISPLAY NAME) matches the
    // caller's own name (D5 — the only module with real per-person attribution before Stage 7).
    //
    // ── D21(a): THE `ownerId` DISJUNCT IS STRICTLY ADDITIVE, AND BOTH HALVES ARE TESTED ────────
    //
    // Additive: no session that could read a row before can be denied one now — the `owner`
    // comparison is unchanged and still stands on its own. `transaction-history.rules.test.ts`
    // holds both halves (a row carrying only `owner` is still readable by its owner; a row whose
    // `owner` holds a STALE display name is readable via `ownerId`), because "strictly additive"
    // is a claim about what is NOT lost and only the first of those can show it.
    //
    // ── WHAT MAKES THE SCOPED LIST QUERY VERIFIABLE AT ALL ─────────────────────────────────────
    //
    // On a LIST operation Firestore verifies this rule SYMBOLICALLY against the QUERY'S
    // CONSTRAINTS, not against any document — so every field the query does not constrain is
    // genuinely undefined and reading it RAISES. Observed on the emulator before D21(a) landed:
    // an `'own'` viewer's scan failed with "Property owner is undefined on object", reported ONCE
    // PER `in` VALUE, which is D21(b)'s DNF expansion made visible.
    //
    // Rules' `||` absorbs an error on one operand when the other is TRUE. That is the whole
    // mechanism: a query carrying `where('ownerId','==',me)` verifies through the FIRST disjunct
    // while the `owner` comparison errors harmlessly beside it, and a single-document read of an
    // unstamped row (no `ownerId` at all) resolves the other way round. Neither shape works alone.
    //
    // !! AND ONE THING TESTED RATHER THAN ASSUMED. An earlier draft of this comment claimed the
    // BARE `data.ownerId` was required here and that `data.get('ownerId', null)` would not bind to
    // the query constraint. T3's rules mutation sweep DISPROVED IT: the `.get(…, null)` form
    // passes all 264 rules tests, list verification included, so it is an EQUIVALENT MUTANT. The
    // bare form is kept only because `ownedModuleAllowed` two screens up has used exactly it since
    // Stage 3 and its D1 regression suite already exercises the list-time half on four
    // collections — a consistency choice, not a correctness one. D21(d)'s immutability conjuncts
    // are the genuinely different case: there the defaulted accessor IS required, because those
    // are `&&` conjuncts where an error DENIES rather than being absorbed.
    function expensesAllowed(action, data) {
      let level = myLevel('expenses', action);
      return level == 'family'
        || (level == 'own' && (data.ownerId == memberId() || data.owner == myMember().name));
    }

    // Ownerless modules (D5): 'own' does not grant access — only 'family' does.
    function ownerlessModuleAllowed(module, action) {
      return myLevel(module, action) == 'family';
    }

    // Stage 3 D1/D2 — a THIRD 'own' convention: `ownerId` is a memberId, not a display name, used
    // by the four collections that ship owned-from-day-one (accounts/recurring/loans/insurances).
    // Distinct from expensesAllowed() (compares data.owner, a NAME) and ownerlessModuleAllowed()
    // (never checks 'own' at all).
    function ownedModuleAllowed(module, action, data) {
      let level = myLevel(module, action);
      return level == 'family' || (level == 'own' && data.ownerId == memberId());
    }

    function canAccessExpenses(action, data) {
      return isSuperAdmin() || isParent() || (hasRole() && expensesAllowed(action, data));
    }
    function canAccessOwnerlessModule(module, action) {
      return isSuperAdmin() || isParent() || (hasRole() && ownerlessModuleAllowed(module, action));
    }
    function canAccessOwnedModule(module, action, data) {
      return isSuperAdmin() || isParent() || (hasRole() && ownedModuleAllowed(module, action, data));
    }

    // ── Schema validation (Stage 1 ledger: `members` had none — closed here) ───────────
    function isValidMember(data) {
      return data.name is string && data.name.size() > 0
        && data.role in ['הורה', 'ילד']
        && data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.groups is list
        && data.createdAt is string && data.updatedAt is string
        && (!('uid' in data) || data.uid == null || data.uid is string)
        && (!('idNumber' in data) || data.idNumber is string)
        && (!('resolvedPermissions' in data) || data.resolvedPermissions is map);
    }

    function isValidGroup(data) {
      return data.name is string && data.name.size() > 0
        && data.memberIds is list
        && data.createdAt is string && data.updatedAt is string;
    }

    function isValidPermissionDoc(data) {
      return data.scope in ['group', 'member']
        && data.targetId is string && data.targetId.size() > 0
        && data.modules is map
        && data.updatedAt is string
        && data.updatedBy is string;
    }

    // Task 8 review F1 — the aiCostConfig write branch below validated WHO writes and never WHAT.
    // A super-admin client-SDK setDoc of `monthlyCeilingILS: 'not a number'` succeeded, and
    // costGate's `Number(...)` then produced NaN — where `NaN <= 0` is false AND
    // `used + est > NaN` is false, so the ceiling check silently admitted everything. A probe
    // pushed a ₪12.50 charge through with ₪999,999 already spent, while the settings screen said
    // no ceiling had been configured. Same shape as isValidMember/isValidGroup above.
    //
    // 1000000 mirrors MAX_MONTHLY_CEILING_ILS in functions/src/costGate/types.ts (Rules have no
    // import mechanism); 0 is deliberately VALID — a configured, maximally-restrictive ceiling
    // meaning "no paid AI this month", which is the one semantic all four layers now agree on.
    function isValidAiCostConfig(data) {
      return data.monthlyCeilingILS is number
        && data.monthlyCeilingILS >= 0
        && data.monthlyCeilingILS <= 1000000
        && (!('updatedBy' in data) || data.updatedBy is string);
    }

    function isValidAuditEntry(data) {
      return data.actorMemberId is string && data.actorMemberId.size() > 0
        && data.action is string && data.action.size() > 0
        && data.target is string
        && data.at is string;
    }

    // Stage 3 schema validators — one per new collection (spec §7).
    function isValidAccount(data) {
      return data.name is string && data.name.size() > 0
        && data.type in ['bank', 'cash', 'credit']
        && data.ownerId is string && data.ownerId.size() > 0
        && data.balance is number
        && data.balanceUpdatedAt is string
        && data.status in ['active', 'archived']
        && data.createdAt is string && data.updatedAt is string;
    }

    function isValidRecurring(data) {
      return data.kind in ['income', 'expense']
        && data.description is string && data.description.size() > 0
        && data.amount is number && data.amount > 0
        && data.chargeDay is int && data.chargeDay >= 1 && data.chargeDay <= 31
        && data.ownerId is string && data.ownerId.size() > 0
        && data.status in ['active', 'paused', 'ended']
        && data.startDate is string
        && data.createdAt is string && data.updatedAt is string
        && (!('endDate' in data) || data.endDate is string)
        && (!('lastPostedPeriod' in data) || data.lastPostedPeriod is string)
        && (!('category' in data) || data.category is string);
    }

    function isValidLoan(data) {
      return data.name is string && data.name.size() > 0
        && data.loanType in ['mortgage', 'personal', 'creditLine', 'other']
        && data.ownerId is string && data.ownerId.size() > 0
        && data.principal is number && data.principal >= 0
        && data.balance is number && data.balance >= 0
        && data.interestRate is number && data.interestRate >= 0
        && data.monthlyPayment is number && data.monthlyPayment >= 0
        && data.startDate is string && data.endDate is string
        && data.status in ['active', 'paid-off']
        && data.createdAt is string && data.updatedAt is string;
    }

    function isValidInsurance(data) {
      return data.type in ['life', 'health', 'car', 'home', 'other']
        && data.provider is string && data.provider.size() > 0
        && data.insuredMemberId is string && data.insuredMemberId.size() > 0
        && data.ownerId is string && data.ownerId.size() > 0
        && data.premium is number && data.premium >= 0
        && data.premiumFrequency in ['monthly', 'yearly']
        && data.coverages is list
        && data.renewalDate is string
        && data.status in ['active', 'lapsed', 'cancelled']
        && data.createdAt is string && data.updatedAt is string
        && (!('documentId' in data) || data.documentId is string);
    }

    // ── Stage 7 (D25) — forecast_assumptions ─────────────────────────────────────────
    //
    // THE SCHEMA VALIDATOR. Shape only; WHO may write is the match block below.
    //
    // `data.source == 'user'` IS THE STAGE 8 SEAM (D25b), and it is here rather than in a source
    // scan because this project's doctrine is that Rules are the enforced boundary — Stage 6's B4
    // one layer down. Stage 8 widens this literal in THE SAME COMMIT that ships the insight writer.
    // Until then the `'insight'` branch is dead BY RULE, not by convention, which is why D25 cuts
    // the renderer and keeps the field.
    //
    // `fromPeriod`/`toPeriod` are matched against a real 'YYYY-MM' PATTERN, not a length. T0 proved
    // on the emulator that `transaction_lines`' `date.size() == 10` is a LENGTH check and that a
    // matrix-governed 'member' can write `date: "9999-99-99"` through it. A period is the key the
    // whole precedence bucket is built on; it does not get the weaker check.
    //
    // `factor` is bounded for 'seasonality' (D24) — the F1 lesson applied where it is enforced.
    // 0.1/5 mirror SEASONAL_FACTOR_MIN/MAX in src/types/finance.ts (Rules have no import
    // mechanism); forecastAssumptions.test.ts reads these literals back out of this file.
    //
    // 'seasonality' is in the list while the CLIENT union carries only five kinds until T6. That is
    // deliberate: this is the document contract D25 declares, and a validator that could not see
    // the kind its own `factor` bound exists for would be a bound nothing could exercise. The gap
    // is pinned by name at exactly that one member.
    function isValidForecastAssumption(data) {
      return data.scopeKind in ['recurring', 'loan', 'insurance', 'category', 'seasonality', 'personalTarget']
        && data.scopeId is string && data.scopeId.size() > 0
        && data.ownerId is string && data.ownerId.size() > 0
        && data.fromPeriod is string && data.fromPeriod.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && (!('toPeriod' in data) || (data.toPeriod is string && data.toPeriod.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && data.amountILS is number && data.amountILS >= 0
        && data.reasonHe is string && data.reasonHe.size() > 0
        && data.source == 'user'
        && data.status in ['active', 'retired']
        && data.createdAt is string && data.updatedAt is string
        && (!('flexible' in data) || data.flexible is bool)
        && (!('insightId' in data) || data.insightId is string)
        && (data.scopeKind == 'seasonality'
              ? (data.factor is number && data.factor >= 0.1 && data.factor <= 5)
              : (!('factor' in data) || data.factor is number));
    }

    // D25(c) — AUTHORSHIP IS VALIDATED AGAINST THE SCOPE'S OWN MODULE.
    //
    // Without this, a member holding `forecast: family` and `loans: none` could author an
    // assumption over a loan they cannot read, with free-text `reasonHe` rendering on a PARENT's
    // screen: member-authored content injected into a higher-privilege view, and a prompt-injection
    // vector the day Stage 9 puts forecast facts in the AI context.
    //
    // 'category'/'seasonality' scope a spend category, so they answer to `expenses`.
    function forecastScopeModule(scopeKind) {
      return scopeKind == 'recurring' ? 'recurring'
        : scopeKind == 'loan' ? 'loans'
        : scopeKind == 'insurance' ? 'insurances'
        : 'expenses';
    }

    // A30 AS AMENDED — A SELF-OWNED personalTarget IS AUTHORIZED BY OWNERSHIP, NOT BY A GRANT.
    //
    // A 'member' role's default `forecast` level is 'none' (resolveOwnedModuleScope's fail-closed
    // default), so A30 as originally ruled left the child it exists to serve able to see the screen
    // and unable to author their own target — §4 scenario 6 promises "ההוצאות שלו, היעדים שלו", and
    // `goals` is ownerless so a per-member goal does not exist. A member can ALWAYS set a target for
    // themselves; every other scopeKind needs a forecast grant plus the authorship check above.
    function isOwnPersonalTarget(data) {
      return hasRole() && data.scopeKind == 'personalTarget' && data.ownerId == memberId();
    }

    function mayAuthorForecastScope(data) {
      return isSuperAdmin() || isParent()
        || isOwnPersonalTarget(data)
        || myLevel(forecastScopeModule(data.scopeKind), 'view') != 'none';
    }

    // WRITE IS ANTI-SPOOF-BOUND: a matrix-governed caller may only ever author an assumption
    // ATTRIBUTED TO THEMSELVES, at ANY forecast level including 'family'. Same binding
    // `audit_log` uses (`actorMemberId == memberId()`) and `permissions` uses
    // (`updatedBy == memberId()`), for the same reason: `reasonHe` is free text that renders on
    // other people's screens, and a document claiming to be another member's stated belief about
    // their own money is not a thing any UI needs to write.
    //
    // So `forecast: 'family'` vs `'own'` is a READ distinction here, not a write one — D25's own
    // pre-empt says a `forecast: family` holder "may author FAMILY-SCOPED assumptions", i.e. the
    // SCOPE of what an assumption is about widens, not whose documents they may write. Super-admin
    // and parent keep the bypass they have everywhere else.
    function canWriteForecastAssumption(data) {
      return isSuperAdmin() || isParent()
        || (hasRole() && data.ownerId == memberId()
            && (myLevel('forecast', 'edit') != 'none' || data.scopeKind == 'personalTarget'));
    }

    // ── F2 (T2 review) — AUTHORSHIP IS BOUND ON `create` FOR EVERYONE, PARENTS INCLUDED ────────
    //
    // The block above binds a MATRIX-GOVERNED caller to their own `ownerId` and lets super-admin
    // and parent through on the ordinary bypass. `update` then makes `ownerId` immutable for
    // everyone — so the shipped rule was asymmetric in the direction that matters: REATTRIBUTING
    // an existing assumption was denied to a parent while ATTRIBUTING one in the first place was
    // not. A parent could create a document owned by the super-admin or by the other parent, which
    // reaches the same end more cheaply, and T0 measured TWO OF THIS FAMILY'S THREE MEMBERS AS
    // הורה — so the unbound path was the one most of the family is on.
    //
    // An assumption is a NAMED PERSON'S STATED CLAIM ABOUT THEIR OWN MONEY, rendered under their
    // name with free-text `reasonHe`. Nobody needs to author one for somebody else, and this is
    // the same anti-spoof binding `audit_log` (`actorMemberId == memberId()`) and `permissions`
    // (`updatedBy == memberId()`) already apply to every role without exception.
    //
    // WHAT IS DELIBERATELY *NOT* BOUND, stated rather than discovered: a parent may still EDIT and
    // DELETE an existing assumption owned by another member. That is moderation over a claim that
    // already exists and is already attributed — reversible, audit-logged, and `ownerId` still
    // cannot move — not the manufacture of a claim from nothing.
    function authoredBySelf(data) {
      return data.ownerId == memberId();
    }

    // READ is the ordinary owned-module pattern — 'family' sees everyone's, 'own' sees their own —
    // plus the A30 branch, so a zero-permission child can read back the target they just set.
    function canReadForecastAssumption(data) {
      return canAccessOwnedModule('forecast', 'view', data) || isOwnPersonalTarget(data);
    }

    // ── Identity & permission collections ───────────────────────────────────────────
    match /members/{memberId} {
      // hasRole(), not isSignedIn() — a signed-in account with no custom claims (e.g. an
      // anonymous-auth user, or an Auth user created but never provisioned) must get zero
      // access, per the "anonymous users have no access anywhere" requirement. Deviates from
      // the brief's literal isSignedIn() here; see task-5-report.md for the probe that found it.
      allow read: if hasRole();
      allow create, update: if isSuperAdmin() && isValidMember(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read: if hasRole();
      allow create, update: if isSuperAdmin() && isValidGroup(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // D9 — permissions matrix is super-admin-only for read AND write; nothing else needs to
    // read the raw matrix (clients read their own members/{id}.resolvedPermissions instead).
    match /permissions/{permId} {
      allow read: if isSuperAdmin();
      // I3: bind updatedBy to the acting super-admin — matches audit_log's anti-spoof pattern
      // (actorMemberId == memberId()) so a super-admin session can't write a matrix doc
      // attributed to a different member.
      allow create, update: if isSuperAdmin() && isValidPermissionDoc(request.resource.data)
        && request.resource.data.updatedBy == memberId();
      allow delete: if isSuperAdmin();
    }

    // D7 (Stage 3) — role() broadened from ['super-admin','parent'] to also include 'member'.
    // The recurring catch-up engine (Task 5) writes an audit_log entry in the SAME WriteBatch as
    // every auto-posted transaction/income doc; Firestore batches are all-or-nothing, so under
    // the Stage 2 rule a 'member'-role user's own session could never successfully catch-up-post
    // even a fully-owned recurring item (the audit_log write would deny the whole batch). The
    // anti-spoof binding (actorMemberId == memberId()) and shape validation are unchanged — this
    // widens WHO may write an entry, not what they may claim it says.
    match /audit_log/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
        && role() in ['super-admin', 'parent', 'member']
        && request.resource.data.actorMemberId == memberId()
        && isValidAuditEntry(request.resource.data);
      allow update, delete: if false; // immutable log
    }

    // ── Financial modules governed by the matrix ────────────────────────────────────
    match /transaction_lines/{docId} {
      allow read: if canAccessExpenses('view', resource.data);
      // T3 review F1 — `owner is string`, the type check that was NOT here while `amount` and
      // `date` both had one. The asymmetry was the defect: a reader of this rule would reasonably
      // conclude all three payload fields were typed, and `owner` is the field the read path's
      // D21(a) disjunct compares, the field `resolveOwnerId` turns into an `ownerId`, and the
      // field rendered onto other members' screens. A SUPER-ADMIN creating `owner: 12345` was
      // proven live in T3's review. Every one of the four live constructors already writes a
      // string here, so this narrows nothing any of them can do.
      allow create: if canAccessExpenses('edit', request.resource.data)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.owner is string
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      // Update must authorize against the PRE-image (can the caller touch this row at all)
      // AND, for matrix-governed callers (not super-admin/parent), validate the POST-image:
      // owner is immutable (an 'own'-level editor may not reassign the row to someone else's
      // identity) and the same amount/date shape create() enforces is re-applied, since create's
      // checks don't otherwise run on update. Super-admin/parent remain a trusted bypass.
      //
      // ── D21(d) — `period` AND `ownerId` ARE IMMUTABLE, FOR EVERYONE, AND THE PLACEMENT IS THE
      //    WHOLE POINT ────────────────────────────────────────────────────────────────────────
      //
      // The two comparisons below are CONJUNCTS OF `allow update` ITSELF, deliberately OUTSIDE the
      // `isSuperAdmin() || isParent() || (…)` alternation. That alternation is a PARENT BYPASS —
      // T0's live probes confirmed a parent can set `date` to the NUMBER 12345, can change `date`
      // without touching `period`, and can change `owner` — and T0 measured TWO OF THIS FAMILY'S
      // THREE MEMBERS AS הורה. Putting the check on the matrix-governed branch, "the shape the
      // rules already use for owner", would bind one member out of three, and not the two most
      // likely to be editing rows. A parent desynchronising `period` from `date` silently moves
      // money between months on a screen nobody is looking at.
      //
      // ── AND THE SHAPE IS LOAD-BEARING ────────────────────────────────────────────────────────
      //
      // `.get(field, null)`, not `resource.data.period`. NO ROW HAS `period` AT T2 TIME — T3's
      // backfill is what creates it — and a missing map key in Rules is an ERROR, and an error in
      // an `&&` chain DENIES. A bare comparison would therefore deny EVERY matrix-governed edit to
      // EVERY transaction between T2 and T3. With the defaulted accessor: absent on both sides is
      // `null == null` ⇒ allowed; present and changed ⇒ denied; and ADDING the field to a row that
      // lacked it is denied too, which is what we want — `period` is stamped by the backfill and by
      // the constructors at create time, never by an edit.
      //
      // Super-admin/parent keep their bypass of the owner/amount/date re-validation, which is a
      // deliberate pre-existing trust decision this stage does not re-open. NOBODY bypasses this.
      //
      // ── AND T3 REVIEW F1 — THE TYPE CHECKS ARE CONJUNCTS TOO, FOR THE SAME REASON ────────────
      //
      // Closing `owner is string` on CREATE alone would not have closed the state: T0 probed a
      // PARENT setting `date` to the number 12345, and the alternation below is exactly the
      // bypass that let it. These two are TYPE constraints and nothing more — a parent may still
      // change `owner`, still change `date`, still change `amount` to any value they like, which
      // is the pre-existing trust decision this stage does not re-open. What they may no longer do
      // is leave a field holding something no reader of this collection can read.
      //
      // `.get(field, '')`, not a bare access, for D21(d)'s own reason one paragraph up: a bare
      // comparison on a field some row lacks is an ERROR, and an error in an `&&` chain DENIES.
      // Absent defaults to `''`, which is a string, so a row without an `owner` stays editable.
      //
      // ── T4 REVIEW F-1 — AND THAT DEFAULT IS ALSO WHAT LET A PARENT DELETE THE FIELD ─────────
      //
      // `request.resource.data.get('date', '')` is SATISFIED BY ABSENCE: `''` is a string, so a
      // `deleteField()` passed a check written to stop the field being unreadable. The paragraph
      // above says "what they may no longer do is leave a field holding something no reader of
      // this collection can read" — and a live probe defeated that sentence with one `updateDoc`,
      // leaving a row at `{ownerId, period, category}`: no date, no owner, no amount. `period`
      // survived only because D21(d)'s `.get(f, null) == .get(f, null)` shape already denies
      // deleting THAT — which is the same shape, one field over, doing the job.
      //
      // It is blocking rather than cosmetic because of what that row then does: it PASSES
      // `isExpenseRow` (which reads `category` and `isCredit` and never looks at `amount`), so it
      // reaches T5's moving average, where `sum + undefined` is `NaN` and the headline projected
      // balance renders as `NaN`. That is the failure this whole stage exists to prevent.
      //
      // PRESENCE IS PRESERVED, NOT REQUIRED. `resource.data.get(f, null) == null ||
      // request.resource.data.get(f, null) != null`: a row that never had the field may stay
      // without it — the unstamped rows the backfill has not reached must remain editable, which
      // is D21(d)'s own recorded lesson — and a row that HAS it may not have it taken away. A
      // `keys().hasAll([...])` rule would have denied every edit to every unstamped row.
      //
      // `amount` gains a TYPE conjunct here as well, and it is the same defect from the other
      // side: `amount` was the one payload field with no type check outside the alternation, so a
      // parent writing `amount: 'שלוש מאות'` poisons the identical average by the identical
      // arithmetic. Type only — `amount > 0` stays on create and on the matrix-governed branch,
      // because a VALUE constraint here would re-open the trust decision this stage has twice
      // said it is not re-opening.
      allow update: if canAccessExpenses('edit', resource.data)
        && resource.data.get('period', null) == request.resource.data.get('period', null)
        && resource.data.get('ownerId', null) == request.resource.data.get('ownerId', null)
        && (resource.data.get('date', null) == null || request.resource.data.get('date', null) != null)
        && (resource.data.get('owner', null) == null || request.resource.data.get('owner', null) != null)
        && (resource.data.get('amount', null) == null || request.resource.data.get('amount', null) != null)
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('owner', '') is string
        && request.resource.data.get('amount', 0) is number
        && (
          isSuperAdmin() || isParent()
          || (
            request.resource.data.owner == resource.data.owner
            && request.resource.data.amount is number && request.resource.data.amount > 0
            && request.resource.data.date is string && request.resource.data.date.size() == 10
          )
        );
      // Delete has no post-image to validate — pre-image authorization only.
      allow delete: if canAccessExpenses('edit', resource.data);
    }

    match /incomes/{docId} {
      allow read: if canAccessOwnerlessModule('income', 'view');
      allow create: if canAccessOwnerlessModule('income', 'edit')
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update, delete: if canAccessOwnerlessModule('income', 'edit');
    }

    match /investments/{docId} {
      allow read: if canAccessOwnerlessModule('investments', 'view');
      allow write: if canAccessOwnerlessModule('investments', 'edit');
    }

    match /goals/{docId} {
      allow read: if canAccessOwnerlessModule('goals', 'view');
      allow write: if canAccessOwnerlessModule('goals', 'edit');
    }

    // ── Stage 3 — owned-from-day-one financial modules (D2/D3) ─────────────────────
    match /accounts/{docId} {
      allow read: if canAccessOwnedModule('accounts', 'view', resource.data);
      allow create: if canAccessOwnedModule('accounts', 'edit', request.resource.data) && isValidAccount(request.resource.data);
      // ownerId immutable for matrix-governed editors (D9 — mirrors the transaction_lines C1 fix).
      allow update: if canAccessOwnedModule('accounts', 'edit', resource.data)
        && isValidAccount(request.resource.data)
        && (isSuperAdmin() || isParent() || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if canAccessOwnedModule('accounts', 'edit', resource.data);
    }

    match /recurring/{docId} {
      allow read: if canAccessOwnedModule('recurring', 'view', resource.data);
      allow create: if canAccessOwnedModule('recurring', 'edit', request.resource.data) && isValidRecurring(request.resource.data);
      // Update covers BOTH a human editing the item AND the catch-up engine bumping
      // lastPostedPeriod — ownerId stays immutable for matrix-governed callers either way.
      allow update: if canAccessOwnedModule('recurring', 'edit', resource.data)
        && isValidRecurring(request.resource.data)
        && (isSuperAdmin() || isParent() || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if canAccessOwnedModule('recurring', 'edit', resource.data);
    }

    match /loans/{docId} {
      allow read: if canAccessOwnedModule('loans', 'view', resource.data);
      allow create: if canAccessOwnedModule('loans', 'edit', request.resource.data) && isValidLoan(request.resource.data);
      allow update: if canAccessOwnedModule('loans', 'edit', resource.data)
        && isValidLoan(request.resource.data)
        && (isSuperAdmin() || isParent() || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if canAccessOwnedModule('loans', 'edit', resource.data);
    }

    match /insurances/{docId} {
      allow read: if canAccessOwnedModule('insurances', 'view', resource.data);
      allow create: if canAccessOwnedModule('insurances', 'edit', request.resource.data) && isValidInsurance(request.resource.data);
      allow update: if canAccessOwnedModule('insurances', 'edit', resource.data)
        && isValidInsurance(request.resource.data)
        && (isSuperAdmin() || isParent() || request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if canAccessOwnedModule('insurances', 'edit', resource.data);
    }

    // ── Stage 7 (D25) — forecast_assumptions ────────────────────────────────────────
    //
    // ONE match block with conditionals, and never a second one. Firestore ORs across every rule
    // that matches a request, so a second block scoped to (say) personalTarget would UNION with
    // this one and grant whatever the narrower block allows regardless of what this one denies —
    // the 60d1c32 exposure, in which a zero-permission child received the full household net worth
    // in a live probe. `settings/{docId}` carries the same note for the same reason.
    //
    // `create`/`update` are split from `delete` so the schema validator has a
    // `request.resource.data` to inspect; on a delete there is none. Same shape as
    // members/groups/permissions/settings above.
    match /forecast_assumptions/{docId} {
      allow read: if canReadForecastAssumption(resource.data);

      // F2 — `authoredBySelf` applies to EVERY role, including super-admin and parent. See its
      // definition above for why, and for what is deliberately left unbound.
      allow create: if canWriteForecastAssumption(request.resource.data)
        && authoredBySelf(request.resource.data)
        && mayAuthorForecastScope(request.resource.data)
        && isValidForecastAssumption(request.resource.data);

      // Authorized against BOTH images: the caller must be allowed to touch the row as it stands
      // AND as it would stand. `ownerId` is immutable for EVERYONE here — including super-admin and
      // parent — which deliberately departs from the accounts/recurring/loans/insurances precedent
      // one screen up, where that check sits behind an `isSuperAdmin() || isParent()` bypass. Those
      // collections carry a pre-existing trust decision this stage does not re-open; this one is a
      // day old, an assumption is a named person's stated claim about their own future, and
      // reattributing it to another member is not an edit anybody needs to make. Stated here rather
      // than discovered later.
      allow update: if canWriteForecastAssumption(resource.data)
        && canWriteForecastAssumption(request.resource.data)
        && mayAuthorForecastScope(request.resource.data)
        && isValidForecastAssumption(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      // Delete has no post-image to validate — pre-image authorization only, same as every other
      // matrix-governed collection above.
      allow delete: if canWriteForecastAssumption(resource.data);
    }

    // ── Shared/system collections — parents and super-admin manage, everyone signed-in reads ──
    match /settings/{docId} {
      // hasRole(), not isSignedIn() — see the same note on members/{memberId} above.
      //
      // Security fix: `ecosystem` and `budgetConfig` are single blobs holding EVERY member's full
      // net-worth figures (liquid, investments, pensions, crypto, real estate, mortgage) with no
      // per-member slice a rule can carve out. Under a flat hasRole() gate, an emulator probe
      // proved a zero-permission child token could read a parent's entire net-worth document
      // server-side — contradicts spec §4 scenario 6 ("a child asking about a parent's finances
      // is refused"). Fail closed: these two docs are parent/super-admin only, no matrix
      // exception (they have no module for resolvedPermissions to gate). Every other settings doc
      // (categories, syncState, …) holds no per-member financial data and stays on hasRole() —
      // e.g. the category list is needed by every role for the filter UI.
      allow read: if (docId == 'ecosystem' || docId == 'budgetConfig')
        ? (isSuperAdmin() || isParent())
        : hasRole();
      // aiCostConfig (Stage 6, D4): super-admin ONLY, not parent — the one place this stage
      // diverges from the ecosystem/budgetConfig precedent's parent-or-super-admin write, per
      // spec §4's literal role table naming super-admin (not parent) for AI keys/ceilings.
      // Spelled out explicitly here (Sasha B3) — setAiCostCeiling's own role check is irrelevant
      // since the Admin SDK bypasses Rules entirely; without this branch a parent could setDoc
      // the ceiling directly via the client SDK.
      //
      // Task 8 review F1: the role check alone was not enough — it said nothing about the VALUE.
      // `write` is split into create/update + delete (the SAME shape members/groups/permissions
      // already use above, so the schema validator has a `request.resource.data` to inspect;
      // on a delete there is none). This stays ONE `match /settings/{docId}` block with
      // conditionals: Firestore ORs across every matching rule, so a second block for
      // aiCostConfig would re-open the 60d1c32 exposure this structure exists to prevent.
      //
      // ── T3 REVIEW F3 — `migrationState` IS ADMIN-SDK-ONLY, IN BOTH DIRECTIONS ────────────────
      //
      // `settings/migrationState.transactionPeriodBackfill` is the completion marker, and the
      // statistical layer's ENTIRE correctness rests on it: `loadStatisticalHistory` reads it
      // first and does not issue the history query at all until it is set (D21d). Under the
      // `isSuperAdmin() || isParent()` branch below, any parent client session could write it —
      // and the hardened parse only stops a HALF-written record. A well-formed forgery opens the
      // statistical layer over an unstamped corpus, which is R6's failure mode: a moving average
      // over an arbitrary fraction of the ledger, rendered at full confidence, invisible to every
      // instrument downstream because an untouched row has no `period` for the query to return.
      //
      // The marker is written by `scripts/backfill-transaction-periods.ts` on the Admin SDK, which
      // bypasses Rules entirely — so NO client session has ever needed to write it, and denying
      // every client write costs nothing that exists. Deletion is denied on the same footing:
      // clearing the marker is a legitimate operation, and it belongs to whoever ran the backfill,
      // at the same trust boundary. READ stays on `hasRole()` — `readTransactionBackfillMarker`
      // is a client read on every Dashboard render.
      //
      // Conditionals in the ONE match block, never a second block: Firestore ORs across every rule
      // that matches, so a `match /settings/migrationState` of its own would UNION with this one
      // and grant whatever it allowed regardless of what this denies — the 60d1c32 exposure.
      allow create, update: if docId == 'migrationState'
        ? false
        : docId == 'aiCostConfig'
        ? (isSuperAdmin() && isValidAiCostConfig(request.resource.data))
        : (isSuperAdmin() || isParent());
      // Delete keeps EXACTLY the rights the previous single `allow write` gave it — super-admin
      // only for aiCostConfig, super-admin-or-parent elsewhere. The split above is purely so the
      // schema validator has a `request.resource.data` to inspect (there is none on a delete);
      // it is deliberately NOT an opportunity to tighten delete, which the Task 8 review already
      // verified adversarially. Deleting the doc is safe regardless: it produces the 'unset'
      // state, which the cost gate fails CLOSED on (every paid call refused).
      allow delete: if docId == 'migrationState'
        ? false
        : docId == 'aiCostConfig'
        ? isSuperAdmin()
        : (isSuperAdmin() || isParent());
    }

    match /categories/{docId} {
      allow read: if hasRole();
      allow write: if isSuperAdmin() || isParent();
    }

    match /sync_logs/{docId} {
      allow read, write: if isSuperAdmin() || isParent();
    }

    // D9 (Stage 6 Task 1) — this collection had NO match block at all (Stage 5 ledger finding
    // M3), meaning under default-deny the document<->record link FileProcessor.ts wrote here was
    // very likely being silently denied in production already. No dedicated permission module
    // exists for `documents` yet (spec has no matrix row for it) and spec §4 scenario 2 names
    // document ingestion as a parent-at-the-computer action — fail-closed to super-admin/parent,
    // same reasoning as the settings/ecosystem precedent. Closed here, in the same task that
    // reopens the write path (commitExtractionDraft, the only writer left after D7's HITL fix).
    match /documents/{docId} {
      allow read, write: if isSuperAdmin() || isParent();
    }

    // Legacy — only scripts/migrate-transactions.ts (Admin SDK, bypasses Rules entirely) ever
    // touches this collection now that Stage 1 Task 5 removed every client read. Locked down.
    match /transactions/{docId} {
      allow read, write: if false;
    }

    // AI cost-gate collections (Stage 6 Task 3, D4) — Function-only. The client never reads
    // these directly; Task 8's getAiUsageSummary callable computes and returns the numbers
    // instead, so no Rules relaxation is needed for a usage dashboard to exist. The Admin SDK
    // (costGate.ts, requestAiOverageApproval.ts) bypasses these Rules entirely, same as every
    // other Function-only write in this project (e.g. /transactions above).
    match /ai_usage/{docId} { allow read, write: if false; }
    match /ai_usage_counters/{docId} { allow read, write: if false; }
    match /ai_overage_approvals/{docId} { allow read, write: if false; }

    // chat_sessions/{memberId}/sessions/{sessionId} (Stage 6 Task 5, spec §7) — written only by
    // aiChat (Admin SDK, bypasses Rules), keyed by the caller's VERIFIED memberId in the path
    // itself, not a bare client-supplied UUID field (Sun W9 fix — a landmine for a future
    // history UI otherwise). No client history-browsing UI ships this stage (the chat panel
    // keeps its own in-memory message list) — read access is deferred to whichever future stage
    // builds that UI, named here so it isn't silently assumed to already work.
    match /chat_sessions/{memberId}/sessions/{sessionId} { allow read, write: if false; }
  }
}
