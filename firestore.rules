rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Require Firebase Auth (anonymous or otherwise) for all access
    match /transactions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10;
      allow update, delete: if request.auth != null;
    }

    match /transaction_lines/{docId} {
      allow read, write: if request.auth != null;
    }

    match /investments/{docId} {
      allow read, write: if request.auth != null;
    }

    match /incomes/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if request.auth != null;
    }

    match /goals/{docId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read, write: if request.auth != null;
    }

    match /sync_logs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Task 6 (Stage 1): members as a first-class collection, replacing the array
    // embedded in settings/budgetConfig.
    match /members/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
