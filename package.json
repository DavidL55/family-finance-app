{
  "name": "familyfinance",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "vite --port=3000 --host=0.0.0.0",
    "emu": "npx tsx scripts/dev-emulators.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:rules": "firebase emulators:exec --project demo-familyfinance --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "npm --prefix functions test",
    "test:ai-live": "npm --prefix functions run test:live",
    "test:all": "npm test && npm run test:build && npm run test:functions && npm run test:rules",
    "provision:auth": "npx tsx scripts/provision-auth-users.ts --apply"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.13.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  }
}
